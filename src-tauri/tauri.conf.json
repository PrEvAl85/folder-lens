{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "folder-lens",
  "version": "0.1.0",
  "identifier": "com.folderlens.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "folder-lens — инвентаризация папок",
        "width": 1200,
        "height": 780,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
